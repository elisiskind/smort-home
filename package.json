{
  "name": "smort-home",
  "version": "0.0.1",
  "description": "For the smortest homes only",
  "main": "index.js",
  "license": "MIT",
  "devDependencies": {
    "husky": ">=6",
    "lint-staged": ">=10",
    "pinst": ">=2",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "scripts": {
    "postinstall": "husky",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "workspaces": [
    "lib/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.5.1"
}
