{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES6",
    "sourceMap": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "types": [],
    "jsx": "react",
    "noEmit": false,
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}