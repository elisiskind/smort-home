{
  "name": "smort-home",
  "version": "0.0.1",
  "description": "For the smortest homes only",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "smort-home-server",
    "smort-home-web"
  ],
  "dependencies": {
    "@nestjs/config": "^3.2.3"
  },
  "devDependencies": {
    "husky": ">=6",
    "lint-staged": ">=10",
    "pinst": ">=2",
    "prettier": "^3.3.3"
  },
  "resolutions": {
    "@mui/material": "npm:@mui/joy@latest"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "scripts": {
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  }
}
